{
    "name": "behemot-api-back-node",
    "version": "1.0.0",
    "description": "Simple repository, containing skeleton of NodeJS (Express JS) project with backend (API). ",
    "main": "server.ts",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "concurrently --kill-others-on-fail \"npm:dev:api\" \"npm:dev:worker\"",
        "prisma:full": "prisma generate && prisma migrate deploy",
        "dev:api": "nodemon",
        "dev:worker": "nodemon --watch src --ext ts --exec \"ts-node --files src/worker.ts\"",
        "build": "npm run swagger-generate && tsc && node dist/src/cli/copyStaticAssets.js",
        "swagger-generate": "node swagger.js",
        "postman-generate": "ts-node --files src/cli/generatePostmanCollection.ts",
        "db-seed": "ts-node --files src/cli/seedRolesPrivileges.ts"
    },
    "author": "St1reX",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@socket.io/redis-adapter": "^8.3.0",
        "@socket.io/redis-emitter": "^5.1.0",
        "bullmq": "^5.78.0",
        "connect-redis": "^8.0.1",
        "cors": "^2.8.5",
        "csv-writer": "^1.6.0",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-handlebars": "^8.0.1",
        "express-rate-limit": "^8.0.1",
        "express-session": "^1.18.1",
        "fast-glob": "^3.3.3",
        "get-stream": "^9.0.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.6.0",
        "mysql2": "^3.24.4",
        "node-statsd": "^0.1.1",
        "nodemailer": "^8.0.10",
        "nodemailer-express-handlebars": "^7.0.0",
        "passport": "^0.7.0",
        "passport-local": "^1.0.0",
        "pdfkit": "^0.16.0",
        "pdfkit-table": "^0.1.99",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "prisma": "^7.8.0",
        "prom-client": "^15.1.3",
        "response-time": "^2.3.3",
        "socket.io": "^4.8.3",
        "swagger-autogen": "^2.23.7",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^3.24.2",
        "zod-openapi": "^4.2.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/express-session": "^1.18.1",
        "@types/get-stream": "^3.0.1",
        "@types/node": "^22.13.9",
        "@types/node-statsd": "^0.1.6",
        "@types/nodemailer": "^6.4.17",
        "@types/nodemailer-express-handlebars": "^4.0.5",
        "@types/passport": "^1.0.17",
        "@types/passport-local": "^1.0.38",
        "@types/pdfkit": "^0.13.9",
        "@types/response-time": "^2.3.8",
        "@types/swagger-ui-express": "^4.1.8",
        "concurrently": "^10.0.3",
        "nodemon": "^3.1.9",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.2"
    }
}
