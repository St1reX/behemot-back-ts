{
  "openapi": "3.0.0",
  "info": {
    "title": "Behemot API",
    "description": "API documentation for the Behemot backend.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and account verification."
    },
    {
      "name": "Health",
      "description": "Service health checks."
    },
    {
      "name": "Departments",
      "description": "Department management."
    },
    {
      "name": "Warehouses",
      "description": "Warehouse management."
    },
    {
      "name": "Bolma",
      "description": "Internal product catalog integration."
    },
    {
      "name": "Users",
      "description": "User management. Requires corresponding USER privileges."
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in with username and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 25
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/AuthenticatedUser"
                    }
                  },
                  "required": [
                    "user"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 25
                  }
                },
                "required": [
                  "email",
                  "password",
                  "username"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User account created."
          },
          "409": {
            "description": "Email or username is already in use.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/resend-mail": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Resend the account verification email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request processed."
          },
          "422": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Verification email resend cooldown is active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify-account": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify a user account",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account verified."
          },
          "400": {
            "description": "Verification token is invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid verification token query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check whether the API process is running",
        "responses": {
          "200": {
            "description": "API process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check whether API dependencies are available",
        "responses": {
          "200": {
            "description": "API dependencies are available."
          },
          "500": {
            "description": "At least one API dependency is unavailable."
          }
        }
      }
    },
    "/department": {
      "get": {
        "tags": [
          "Departments"
        ],
        "summary": "List active departments",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active departments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Department"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Insufficient privileges."
          }
        }
      },
      "post": {
        "tags": [
          "Departments"
        ],
        "summary": "Create a department",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "shortcut": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  }
                },
                "required": [
                  "name",
                  "shortcut"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Department created."
          },
          "409": {
            "description": "Department name or shortcut is already in use."
          },
          "422": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/department/{id}": {
      "get": {
        "tags": [
          "Departments"
        ],
        "summary": "Get an active department",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Department details."
          },
          "404": {
            "description": "Department not found."
          },
          "422": {
            "description": "Invalid department identifier."
          }
        }
      },
      "patch": {
        "tags": [
          "Departments"
        ],
        "summary": "Update an active department",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "shortcut": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Department updated."
          },
          "404": {
            "description": "Department not found."
          },
          "409": {
            "description": "Department name or shortcut is already in use."
          },
          "422": {
            "description": "Invalid request data."
          }
        }
      },
      "delete": {
        "tags": [
          "Departments"
        ],
        "summary": "Soft delete a department",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Department deleted."
          },
          "404": {
            "description": "Department not found."
          },
          "409": {
            "description": "Department is assigned to an active resource."
          },
          "422": {
            "description": "Invalid department identifier."
          }
        }
      }
    },
    "/warehouse": {
      "get": {
        "tags": [
          "Warehouses"
        ],
        "summary": "List active warehouses",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active warehouses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Warehouse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Insufficient privileges."
          }
        }
      },
      "post": {
        "tags": [
          "Warehouses"
        ],
        "summary": "Create a warehouse",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "postalCode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "street": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "buildingNumber": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  }
                },
                "required": [
                  "name",
                  "postalCode",
                  "city",
                  "street",
                  "buildingNumber"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Warehouse created."
          },
          "409": {
            "description": "Warehouse name is already in use."
          },
          "422": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/warehouse/{id}": {
      "get": {
        "tags": [
          "Warehouses"
        ],
        "summary": "Get an active warehouse",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Warehouse details."
          },
          "404": {
            "description": "Warehouse not found."
          },
          "422": {
            "description": "Invalid warehouse identifier."
          }
        }
      },
      "patch": {
        "tags": [
          "Warehouses"
        ],
        "summary": "Update an active warehouse",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "postalCode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "street": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "buildingNumber": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Warehouse updated."
          },
          "404": {
            "description": "Warehouse not found."
          },
          "409": {
            "description": "Warehouse name is already in use."
          },
          "422": {
            "description": "Invalid request data."
          }
        }
      },
      "delete": {
        "tags": [
          "Warehouses"
        ],
        "summary": "Soft delete a warehouse",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Warehouse deleted."
          },
          "404": {
            "description": "Warehouse not found."
          },
          "409": {
            "description": "Warehouse is assigned to an active product."
          },
          "422": {
            "description": "Invalid warehouse identifier."
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the current user with their role and privileges",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user from the current session.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/AuthenticatedUser"
                    }
                  },
                  "required": [
                    "user"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "User not authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/integrations/bolma/status": {
      "get": {
        "tags": [
          "Bolma"
        ],
        "summary": "Check the Bolma catalog database connection",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Database is available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BolmaStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "User not authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BolmaStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": [
          "Users"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "List users that have not been deleted",
        "responses": {
          "200": {
            "description": "Users.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManagedUser"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Insufficient privileges or forbidden own-account operation."
          },
          "404": {
            "description": "User, role or department not found."
          },
          "409": {
            "description": "Email or username already reserved, including soft-deleted accounts."
          },
          "422": {
            "description": "Invalid request data."
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Create an account with an administrator-provided password",
        "description": "Active accounts can log in immediately. No verification email is sent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 25
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "roleId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "departmentId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "isActive": {
                    "type": "boolean"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "writeOnly": true
                  }
                },
                "required": [
                  "username",
                  "email",
                  "roleId",
                  "departmentId",
                  "isActive",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedUser"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Insufficient privileges or forbidden own-account operation."
          },
          "404": {
            "description": "User, role or department not found."
          },
          "409": {
            "description": "Email or username already reserved, including soft-deleted accounts."
          },
          "422": {
            "description": "Invalid request data."
          }
        }
      }
    },
    "/user/form-options": {
      "get": {
        "tags": [
          "Users"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "List available roles and departments for the user editor",
        "description": "Requires USER:CREATE or USER:UPDATE.",
        "responses": {
          "200": {
            "description": "Editor options.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name"
                        ]
                      }
                    },
                    "departments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Insufficient privileges or forbidden own-account operation."
          },
          "404": {
            "description": "User, role or department not found."
          },
          "409": {
            "description": "Email or username already reserved, including soft-deleted accounts."
          },
          "422": {
            "description": "Invalid request data."
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "summary": "Get a user",
        "responses": {
          "200": {
            "description": "User.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedUser"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Insufficient privileges or forbidden own-account operation."
          },
          "404": {
            "description": "User, role or department not found."
          },
          "409": {
            "description": "Email or username already reserved, including soft-deleted accounts."
          },
          "422": {
            "description": "Invalid request data."
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "summary": "Update user data, role, department and status",
        "description": "Cannot change own role or deactivate own account. Password is not changed. Status or email changes invalidate pending verification links; saving an inactive account also invalidates its pending links.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 25
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "roleId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "departmentId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
