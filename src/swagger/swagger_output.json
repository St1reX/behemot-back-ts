                    "maxLength": 100
                  },
                  "street": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "buildingNumber": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  }
                },
                "required": [
                  "name",
                  "postalCode",
                  "city",
                  "street",
                  "buildingNumber"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Warehouse created."
          },
          "409": {
