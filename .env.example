# Skopiuj ten plik do .env i uzupelnij wymagane wartosci.
# NODE_ENV: development, production lub test.
NODE_ENV=

# PostgreSQL (Docker Compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Redis: lokalnie redis://localhost:6379 i redis://localhost:6380
REDIS_URL=
BULLMQ_REDIS_URL=

# Sesja i domena ciasteczek (COOKIE_DOMAIN jest wymagane takze w development)
SESSION_SECRET=
COOKIE_DOMAIN=

# Oba zestawy API sa wymagane niezaleznie od NODE_ENV.
# URL musi zawierac protokol, a port musi byc liczba od 1 do 65535.
DEV_API_URL=
DEV_API_PORT=
PROD_API_URL=
PROD_API_PORT=

# Opcjonalne adresy frontendu: odkomentuj i podaj pelny URL, jesli potrzebne.
# DEV_FRONTEND_URL=
# PROD_FRONTEND_URL=

# SMTP (SMTP_FROM_ADDRESS jest uzywane przez Grafane)
SMTP_HOST=
SMTP_PORT=
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
